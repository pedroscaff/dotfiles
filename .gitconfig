[user]
  email = pedro@sanctuary.computer
  name = Pedro Scaff
[alias]
  st = status -sb
  l = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
  c = checkout
[core]
  editor = nvim
[push]
  default = simple
[url "ssh://git@github.com/"]
  insteadOf = https://github.com/
[init]
  defaultBranch = main
